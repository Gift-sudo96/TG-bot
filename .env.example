# Токен від @BotFather
BOT_TOKEN=123456:AAAA-your-token-here

# Хто може користуватись ботом (Telegram ID через кому).
# Свій ID дізнаєшся, написавши боту /id
ALLOWED_IDS=111111111,222222222

# true  -> нагадування приходить ВСІМ з ALLOWED_IDS (спільна робота)
# false -> нагадування приходить тільки тому, хто його створив
NOTIFY_ALL=true

# Година за замовчуванням, коли вказана лише дата без часу
DEFAULT_HOUR=9

TZ_NAME=Europe/Kyiv

# Як підписувати автора нагадування. Формат: ID:Імʼя через кому.
# Якщо когось тут немає, візьметься імʼя з профілю Telegram.
NAMES=111111111:Сергій,222222222:Аріна

# Поки не натиснули "Готово", нагадування повертається кожні REPEAT_HOURS
# годин, але тільки в проміжку DAY_START..DAY_END. Пізніше — наступного ранку.
REPEAT_HOURS=4
DAY_START=9
DAY_END=21
